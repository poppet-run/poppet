{
  "name": "poppet",
  "version": "0.0.0",
  "private": true,
  "description": "A small personal AI agent for local use.",
  "license": "BSD-3-Clause",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun apps/cli/src/main.ts",
    "dev": "bun --watch apps/cli/src/main.ts",
    "typecheck": "bun --check && bun run --workspaces typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test --parallel=4",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
