{
  "name": "poppet",
  "version": "0.0.0",
  "private": true,
  "description": "A small personal AI agent for local use.",
  "license": "BSD-3-Clause",
  "bin": {
    "poppet": "apps/cli/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun --check && bun run --workspaces typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun run build:web && bun --no-env-file tools/testing/run.ts --parallel=4 --max-concurrency=2",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "build:web": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
