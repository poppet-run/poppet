{
  "name": "poppet",
  "version": "0.0.0",
  "private": true,
  "description": "A small personal AI agent for local use.",
  "license": "BSD-3-Clause",
  "bin": {
    "poppet": "apps/cli/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun --check && effect-tsgo tsc && bun run --workspaces typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun run build:web && bun --no-env-file tools/testing/run.ts --parallel=4 --max-concurrency=2",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "build:web": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "1.4.5",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "re2-wasm@1.0.2": "patches/re2-wasm@1.0.2.patch"
  }
}
