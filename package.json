{
  "name": "poppet",
  "version": "0.0.0",
  "private": true,
  "description": "A small personal AI agent for local use.",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.4",
    "effect": "4.0.4",
    "jose": "6.2.12",
    "openai": "7.32.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
