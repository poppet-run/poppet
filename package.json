{
  "name": "poppet",
  "version": "0.0.0",
  "private": true,
  "description": "A small personal AI agent for local use.",
  "license": "BSD-3-Clause",
  "bin": {
    "poppet": "apps/cli/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun --check && bun run --workspaces typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun run build:web && bun --no-env-file tools/testing/run.ts --parallel=4 --max-concurrency=2",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "build:web": "bun run --cwd apps/web build",
    "prepare": "test x\"$CI\" != x || test ! -e .git || lefthook install"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@effect/tsgo": "0.73.7",
    "@oxlint/plugins": "1.95.0",
    "@types/bun": "1.4.5",
    "lefthook": "2.2.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "re2-wasm@1.0.2": "patches/re2-wasm@1.0.2.patch"
  }
}
