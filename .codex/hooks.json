{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/tools/hooks/hook-bypass.ts\"",
            "statusMessage": "Checking for Git hook bypasses"
          }
        ]
      }
    ]
  }
}
