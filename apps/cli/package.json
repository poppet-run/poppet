    "@poppet/channel-discord": "workspace:*",
    "@poppet/channel-telegram": "workspace:*",
    "@poppet/channel-whatsapp": "workspace:*",
    "@poppet/config": "workspace:*",
    "@poppet/credentials": "workspace:*",
    "@poppet/gateway": "workspace:*",
    "@poppet/io": "workspace:*",
    "@poppet/mcp": "workspace:*",
    "@poppet/memory": "workspace:*",
    "@poppet/platform": "workspace:*",
    "@poppet/platform-macos": "workspace:*",
    "@poppet/provider": "workspace:*",
    "@poppet/provider-openai": "workspace:*",
    "@poppet/provider-opencode": "workspace:*",
    "@poppet/provider-openrouter": "workspace:*",
    "@poppet/store": "workspace:*",
    "@poppet/tasks": "workspace:*",
    "@poppet/worker": "workspace:*",
    "effect": "4.0.4"
  }
