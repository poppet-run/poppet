{
  "name": "@poppet/cli",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "bun --check && effect-tsgo tsc",
    "test": "bun --no-env-file ../../tools/testing/run.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.5",
    "@poppet/agent": "workspace:*",
    "@poppet/channel-discord": "workspace:*",
    "@poppet/channel-slack": "workspace:*",
    "@poppet/config": "workspace:*",
    "@poppet/credentials": "workspace:*",
    "@poppet/gateway": "workspace:*",
    "@poppet/io": "workspace:*",
    "@poppet/mcp": "workspace:*",
    "@poppet/memory": "workspace:*",
    "@poppet/platform": "workspace:*",
    "@poppet/provider": "workspace:*",
    "@poppet/provider-openai": "workspace:*",
    "@poppet/provider-opencode": "workspace:*",
    "@poppet/provider-openrouter": "workspace:*",
    "@poppet/sign-in": "workspace:*",
    "@poppet/store": "workspace:*",
    "@poppet/tasks": "workspace:*",
    "@poppet/web": "workspace:*",
    "@poppet/web-search": "workspace:*",
    "@poppet/worker": "workspace:*",
    "effect": "4.1.5",
    "marked": "18.2.1",
    "marked-terminal": "8.0.0",
    "wrap-ansi": "10.0.2"
  }
}
