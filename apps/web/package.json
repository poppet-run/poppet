{
  "name": "@poppet/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/api/protocol.ts"
  },
  "scripts": {
    "build": "bun run build:css && rm -rf ./dist && bun build ./index.html --outdir ./dist --target browser --public-path / --minify",
    "typecheck": "bun --check",
    "build:css": "bun --bun tailwindcss -i ./src/styles/style.css -o ./.generated/style.css --minify"
  },
  "dependencies": {
    "@nanostores/preact": "1.1.1",
    "@nanostores/query": "0.3.4",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "nanostores": "1.5.5",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/jsdom": "30.0.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3"
  }
}
